# Public DNS name only (no scheme or path), for example numera.example.com.
DOMAIN=

# Strong password shared by the PostgreSQL bootstrap, migration, app, and Hangfire roles.
DB_PASSWORD=

# Optional Keycloak bootstrap/admin-service username; keep "admin" unless intentionally changed.
KEYCLOAK_ADMIN_USERNAME=admin

# Strong password for the Keycloak bootstrap admin and the BFF Admin API login.
KEYCLOAK_ADMIN_PASSWORD=

# Must exactly match the numera-bff client secret in keycloak/realm-numera.json.
KEYCLOAK_CLIENT_SECRET=

# Optional Stripe TEST-mode settings. Leave either secret blank to use the billing stub.
Stripe__SecretKey=
Stripe__WebhookSecret=
# Optional recurring TEST price IDs keyed by the Numera plans.
Stripe__PriceIds__S=
Stripe__PriceIds__M=
Stripe__PriceIds__L=
Stripe__PriceIds__XL=

# Optional finAPI sandbox settings. Leave the credentials/BaseUrl blank to use the banking stub.
FinApi__ClientId=
FinApi__ClientSecret=
FinApi__BaseUrl=
FinApi__WebFormBaseUrl=

