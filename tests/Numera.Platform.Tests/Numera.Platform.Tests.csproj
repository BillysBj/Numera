<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFramework (net10.0) is inherited from Directory.Build.props. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.*" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\platform\Numera.Platform.Money\Numera.Platform.Money.csproj" />
    <ProjectReference Include="..\..\src\platform\Numera.Platform.Entitlements\Numera.Platform.Entitlements.csproj" />
    <!-- Offline VAT-ID validator (pure function) unit-tested here. -->
    <ProjectReference Include="..\..\src\modules\Numera.Modules.Crm\Numera.Modules.Crm.csproj" />
    <!-- UnitOfMeasure code list + defaults (pure) unit-tested here. -->
    <ProjectReference Include="..\..\src\modules\Numera.Modules.Catalog\Numera.Modules.Catalog.csproj" />
    <!-- Sales module (CompanyProfile) referenced so its DLL is deployed next to the
         test assembly for NumeraDbContext entity discovery, matching the Api host. -->
    <ProjectReference Include="..\..\src\modules\Numera.Modules.Sales\Numera.Modules.Sales.csproj" />
    <!-- Numera.Api referenced so the PURE KoSitReport parser + its public result records
         (EInvoiceFinding/EInvoiceValidationResult) are unit-tested here (KoSitReportTests) with
         no sidecar/Docker — the parser lives in the Api Services alongside the HttpClient it
         feeds (05-02). Mirrors how Numera.IntegrationTests references Numera.Api (03-11). -->
    <ProjectReference Include="..\..\src\Numera.Api\Numera.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden-file fixtures are copied next to the test assembly for reading at runtime. -->
    <!-- Reuse the isolated PostgreSQL/RLS fixture for supplier-payment cash-recognition tests. -->
    <Compile Include="..\Numera.IntegrationTests\PostgresFixture.cs" Link="Fixtures\PostgresFixture.cs" />
    <None Include="Money\goldenfiles\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Money\goldenfiles\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="Sales\goldenfiles\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Sales\goldenfiles\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
