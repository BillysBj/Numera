<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Real-Postgres integration suite (Testcontainers). net10.0 so it can reference
      the platform assemblies. Not packable; flagged as a test project so the SDK
      wires xUnit discovery.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test project: no XML docs, and don't fail the build on analyzer noise. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Platform.Audit is referenced so Numera.Platform.Audit.dll is copied next to
      the test assembly: NumeraDbContext discovers the tenant-scoped AuditEvent
      entity by probing its own output directory (cycle-avoidance pattern), so the
      DLL must be present for the model (and thus these suites) to see audit_events.
    -->
    <ProjectReference Include="..\..\src\platform\Numera.Platform.Db\Numera.Platform.Db.csproj" />
    <ProjectReference Include="..\..\src\platform\Numera.Platform.Tenancy\Numera.Platform.Tenancy.csproj" />
    <ProjectReference Include="..\..\src\platform\Numera.Platform.Audit\Numera.Platform.Audit.csproj" />
    <!-- Banking is referenced both for direct isolation-test type use and so its
         reflectively discovered entities are present in the runtime EF model. -->
    <ProjectReference Include="..\..\src\modules\Numera.Modules.Banking\Numera.Modules.Banking.csproj" />
    <!--
      Modules.Ledger is referenced so its DLL is deployed next to the test assembly:
      NumeraDbContext discovers the inert ledger entities the same way the Api host
      does, making the runtime model match the shipped migration snapshot (otherwise
      EF 10 raises PendingModelChangesWarning when applying migrations).
    -->
    <ProjectReference Include="..\..\src\modules\Numera.Modules.Ledger\Numera.Modules.Ledger.csproj" />
    <!--
      Modules.Crm is referenced so its DLL is deployed next to the test assembly:
      NumeraDbContext discovers the CRM ITenantEntity types (partners, partner_*) the
      same way the Api host does, and the StammdatenRlsTests use the entity classes
      directly to prove per-table RLS isolation on real Postgres.
    -->
    <ProjectReference Include="..\..\src\modules\Numera.Modules.Crm\Numera.Modules.Crm.csproj" />
    <!--
      Modules.Catalog is referenced so its DLL is deployed next to the test assembly:
      NumeraDbContext discovers the CatalogItem ITenantEntity the same way the Api host
      does, and CatalogRlsTests use the entity class directly to prove per-table RLS
      isolation and per-tenant article-number uniqueness on real Postgres.
    -->
    <ProjectReference Include="..\..\src\modules\Numera.Modules.Catalog\Numera.Modules.Catalog.csproj" />
    <!--
      Modules.Sales is referenced so its DLL is deployed next to the test assembly:
      NumeraDbContext discovers the CompanyProfile ITenantEntity the same way the Api
      host does, and CompanyProfileRlsTests use the entity class directly to prove
      per-table RLS isolation on real Postgres.
    -->
    <ProjectReference Include="..\..\src\modules\Numera.Modules.Sales\Numera.Modules.Sales.csproj" />
    <!--
      Numera.Api is referenced so the finalize/Storno/concurrency suites bind to the REAL
      production finalize core: SalesDocumentEndpoints.FinalizeCoreAsync is internal +
      [InternalsVisibleTo("Numera.IntegrationTests")], so these tests drive the actual
      shipped code path (GAP-3 regression guard) instead of a parallel reimplementation.
    -->
    <ProjectReference Include="..\..\src\Numera.Api\Numera.Api.csproj" />
  </ItemGroup>

</Project>
