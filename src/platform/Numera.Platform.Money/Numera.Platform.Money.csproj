<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Target net8.0 today (installed SDK is 8.0.x). The Money type and
      RoundingPolicy are TFM-agnostic and forward-compatible to net10.0;
      retarget when the .NET 10 LTS SDK is provisioned (see STACK.md).
    -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML comment warnings are not build-blocking for this library. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NodaMoney" Version="2.7.0" />
  </ItemGroup>

</Project>
