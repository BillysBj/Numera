<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <RootNamespace>Numera.Worker</RootNamespace>
    <AssemblyName>Numera.Worker</AssemblyName>
    <UserSecretsId>numera-worker</UserSecretsId>
    <!-- The Worker references the Api project (shared Hangfire jobs); both ship an
         appsettings.json, which collides on `dotnet publish` (NETSDK1152). Prod config
         comes from environment variables (compose), so tolerating the duplicate is safe. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.*" />
    <!-- Background job processing host (generic-host Hangfire), Postgres-backed. -->
    <PackageReference Include="Hangfire.NetCore" Version="1.8.*" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.*" />
    <!-- Override Hangfire's transitive Newtonsoft.Json 11.0.1 (NU1903 vulnerability);
         13.0.4 also satisfies EFCore.Design's floor (avoids the NU1605 downgrade). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\platform\Numera.Platform.Db\Numera.Platform.Db.csproj" />
    <ProjectReference Include="..\modules\Numera.Modules.Banking\Numera.Modules.Banking.csproj" />
    <ProjectReference Include="..\Numera.Api\Numera.Api.csproj" />
  </ItemGroup>

</Project>
