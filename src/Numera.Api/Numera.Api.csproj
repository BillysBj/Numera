<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Numera.Api</RootNamespace>
    <AssemblyName>Numera.Api</AssemblyName>
    <UserSecretsId>numera-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Grant the integration-test assembly access to the internal FinalizeCoreAsync so
         the finalize/Storno/concurrency suites drive the REAL production finalize core
         (not a parallel reimplementation) — regression-guards the GAP-1 db.Add fix. -->
    <InternalsVisibleTo Include="Numera.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required by the EF Core tools (dotnet ef) when Api is the startup project. -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- BFF confidential OIDC client (cookie + OpenIdConnect against Keycloak). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.*" />
    <!-- Background jobs (welcome-email skeleton), Postgres-backed. -->
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.*" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.*" />
    <!-- Override Hangfire's transitive Newtonsoft.Json 11.0.1 (NU1903 vulnerability). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\platform\Numera.Platform.Db\Numera.Platform.Db.csproj" />
    <!-- Server-authoritative tier entitlements + FeatureManagement plan filter. -->
    <ProjectReference Include="..\platform\Numera.Platform.Entitlements\Numera.Platform.Entitlements.csproj" />
    <!-- Referenced so the modular-monolith host loads the ledger assembly, letting
         NumeraDbContext discover its ITenantEntity types for the shared migration. -->
    <ProjectReference Include="..\modules\Numera.Modules.Ledger\Numera.Modules.Ledger.csproj" />
    <!-- Referenced so the CRM assembly (BusinessPartner + partner_* entities) is
         deployed next to Platform.Db, letting NumeraDbContext discover its
         ITenantEntity types for the shared design-time migration. -->
    <ProjectReference Include="..\modules\Numera.Modules.Crm\Numera.Modules.Crm.csproj" />
    <!-- Referenced so the Catalog assembly (CatalogItem) is deployed next to
         Platform.Db, letting NumeraDbContext discover its ITenantEntity type for the
         shared design-time migration. -->
    <ProjectReference Include="..\modules\Numera.Modules.Catalog\Numera.Modules.Catalog.csproj" />
    <!-- Referenced so the Sales assembly (CompanyProfile issuer master data) is
         deployed next to Platform.Db, letting NumeraDbContext discover its
         ITenantEntity type for the shared design-time migration. -->
    <ProjectReference Include="..\modules\Numera.Modules.Sales\Numera.Modules.Sales.csproj" />
    <!-- Referenced so Platform.Audit (AuditEvent + AuditWriter) is deployed next to
         Platform.Db, letting NumeraDbContext discover the audit_events entity for the
         shared migration and letting the host wire IAuditWriter (01-06). -->
    <ProjectReference Include="..\platform\Numera.Platform.Audit\Numera.Platform.Audit.csproj" />
  </ItemGroup>

</Project>
